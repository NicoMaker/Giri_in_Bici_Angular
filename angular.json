{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "giri-in-bici": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/giri-in-bici",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets/json",
                "output": "assets/json"
              },
              {
                "glob": "**/*",
                "input": "src/assets/img",
                "output": "assets/img"
              },
              {
                "glob": "**/*",
                "input": "src/assets/css",
                "output": "assets/css"
              },
              "src/robots.txt"
            ],
            "styles": [
              "src/assets/css/assets/componenti/base/reset.css",
              "src/assets/css/assets/componenti/base/token.css",
              "src/assets/css/assets/componenti/base/tipografia.css",
              "src/assets/css/assets/core.css",
              "src/assets/css/tema.css",
              "src/assets/css/About_US/StyleAbout.css",
              "src/assets/css/About_US/contatti/contatti.css",
              "src/assets/css/About_US/contatti/dove-andare.css",
              "src/assets/css/About_US/intestazione/base.css",

              "src/assets/css/assets/componenti/layout/struttura/drawer.css",
              "src/assets/css/assets/componenti/layout/struttura/layout.css",
              "src/assets/css/assets/componenti/media/adattamenti-immagini.css",
              "src/assets/css/assets/componenti/media/galleria.css",
              "src/assets/css/assets/componenti/media/lightbox.css",
              "src/assets/css/assets/componenti/tabelle-grafici/grafici.css",
